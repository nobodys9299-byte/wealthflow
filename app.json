{
  "expo": {
    "name": "WealthFlow",
    "slug": "wealthflow-money-tracker",
    "owner": "nobodys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wealthflow.moneytracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "WealthFlow uses Face ID / Touch ID to securely protect your financial data."
      }
    },
    "android": {
      "package": "com.wealthflow.moneytracker",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "527ab6ad-00d7-4f22-a969-f3d50710ef65"
      }
    }
  }
}
