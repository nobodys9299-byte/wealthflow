{
  "expo": {
    "name": "WealthFlow",
    "slug": "wealthflow-money-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wealthflow.moneytracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "WealthFlow uses Face ID / Touch ID to securely protect your financial data."
      }
    },
    "android": {
      "package": "com.wealthflow.moneytracker",
      "allowBackup": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WealthFlow needs access to your photo gallery to select contact photos."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "03c430e0-dd02-415c-9313-d7e4d850feaa"
      }
    },
    "owner": "raonein"
  }
}
